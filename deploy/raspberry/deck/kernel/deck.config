# Modifiche del Deck alla configurazione del kernel di Raspberry Pi OS (Pi 2, 32 bit).

# niente tracing: all'avvio l'inizializzazione delle "eval map" fermava tutto per 1,4 s
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_BLK_DEV_IO_TRACE is not set

# nel kernel, non come moduli, quello che serve subito: display DSI ufficiale da 7" (vc4, ponte
# TC358762, pannello, regolatori, I2C), audio dal jack, overlay della radice
CONFIG_DRM=y
CONFIG_DRM_VC4=y
CONFIG_DRM_TOSHIBA_TC358762=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_RASPBERRYPI_TOUCHSCREEN_ATTINY=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_I2C_BCM2835=y
CONFIG_I2C_MUX=y
CONFIG_I2C_MUX_PINCTRL=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_BCM2835=y
CONFIG_OVERLAY_FS=y

# moduli non compressi (decomprimerli all'avvio costa) e niente logo
# CONFIG_MODULE_COMPRESS is not set
# CONFIG_LOGO is not set
CONFIG_LOCALVERSION="-deck"
# CONFIG_LOCALVERSION_AUTO is not set
