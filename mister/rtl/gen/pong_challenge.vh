function glyph_lit(input [5:0] code, input [9:0] dx, input [9:0] dy);
    reg [7:0] r;
    begin
        r = glyph_row(code, dy[3:0]);
        glyph_lit = (dx < 8 && dy < 8) ? r[7 - dx] : 1'b0;
    end
endfunction
