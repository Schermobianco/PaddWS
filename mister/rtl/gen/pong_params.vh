        4'd0: ch_default_bcd = 28'h0020000;
        4'd1: ch_default_bcd = 28'h0018000;
        4'd2: ch_default_bcd = 28'h0016000;
        4'd3: ch_default_bcd = 28'h0014000;
        4'd4: ch_default_bcd = 28'h0012000;
        4'd5: ch_default_bcd = 28'h0010000;
        4'd6: ch_default_bcd = 28'h0008000;
        4'd7: ch_default_bcd = 28'h0006000;
        4'd8: ch_default_bcd = 28'h0004000;
        4'd9: ch_default_bcd = 28'h0002000;
        default: ch_default_bcd = 28'h0;
    endcase
endfunction
function [3:0] ch_default_level(input [3:0] i);
    case (i)
        4'd0: ch_default_level = 4'd7;
        4'd1: ch_default_level = 4'd7;
        4'd2: ch_default_level = 4'd6;
        4'd3: ch_default_level = 4'd5;
        4'd4: ch_default_level = 4'd5;
        4'd5: ch_default_level = 4'd4;
